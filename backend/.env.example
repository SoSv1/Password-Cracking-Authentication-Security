NODE_ENV=development
HOST=127.0.0.1
PORT=3000
FRONTEND_ORIGIN=http://localhost:8080
# Generate a private key: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
# Replace this placeholder with that output. Keep the same key across restarts.
JWT_SIGNING_KEY=REPLACE_WITH_A_RANDOM_64_CHARACTER_HEX_KEY
ADMIN_USERNAME=admin
ADMIN_PASSWORD=BCIT12
ADMIN_SECRET=defaultSecret
# For HTTPS deployment: NODE_ENV=production and COOKIE_SAME_SITE=None
COOKIE_SAME_SITE=Lax

# Login work only; health and authenticated endpoints have no request quota.
LOGIN_CONCURRENCY=4
LOGIN_QUEUE_SIZE=24
LOGIN_QUEUE_WAIT_MS=1000
LOGIN_BODY_TIMEOUT_MS=2000
LOGIN_WINDOW_MS=60000
LOGIN_ATTEMPTS_PER_WINDOW=30
LOGIN_MAX_CLIENTS=4096
# Safe default for unknown/shared proxies: bounded auth work, no shared-IP lockout.
# Use direct ONLY after verifying socket addresses identify actual external clients.
LOGIN_CLIENT_IP_MODE=unknown
# Exact immediate proxy IPs, comma-separated. Leave empty until verified.
# Listing a proxy asserts that it OVERWRITES X-Forwarded-For with ONE client IP.
# Appended chains, missing/invalid headers fall back to bounded auth work.
# X-Real-IP and all other forwarding headers are ignored.
TRUSTED_PROXY_IPS=
